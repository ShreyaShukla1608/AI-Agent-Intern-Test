# ---------------------------------------------------------------------------
# Aster & Row Customer Support Agent Environment Configuration Template
# ---------------------------------------------------------------------------

# Application Mode
ENVIRONMENT=development
LOG_LEVEL=INFO

# LLM API Provider Credentials (If using external API model)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Vector Store / ChromaDB Settings
CHROMA_PERSIST_DIR=./chroma_db
KNOWLEDGE_BASE_DIR=./knowledge-base

# Security & Guardrails
ENABLE_PII_FILTER=true
ENABLE_PROMPT_INJECTION_PROTECTION=true

# Database Pathing
ORDERS_DATA_PATH=./data/orders.json